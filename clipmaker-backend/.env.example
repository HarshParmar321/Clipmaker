# ─────────────────────────────────────────────────────────────────────
#  Clipmaker — backend configuration
#  Copy to .env and fill in the required values. Everything else has a
#  working default; the values shown are those defaults.
# ─────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ── Highlight models ─────────────────────────────────────────────────
# The fallback chain is comma-separated and tried in order. Providers
# retire models without warning, so a startup check verifies these exist
# on your account and lists what does if they don't.
GROQ_HIGHLIGHT_MODEL=openai/gpt-oss-120b
GROQ_HIGHLIGHT_FALLBACK_MODEL=openai/gpt-oss-20b


# ── Supabase ─────────────────────────────────────────────────────────
# Stores job/clip/artifact metadata. Find these in Settings > API Keys.
# Keep the secret key on the backend only; never in frontend code.
# Without these the API runs on an in-memory store that is lost on restart.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_backend_key_here

# Older Supabase projects can use the legacy service_role key instead:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here

# When true, API calls must send a valid Supabase access token as a
# Bearer token. Requires Supabase to be configured.
AUTH_REQUIRED=false


# ── Output quality ───────────────────────────────────────────────────
# A 9:16 clip is a narrow column cut out of a landscape frame, so the
# SOURCE resolution — not the encoder — sets the ceiling on sharpness:
#   720p source  ->  228px of usable width  ->  2.7x upscale to 1080
#   1440p source ->  456px                  ->  1.2x
# Lower MAX_SOURCE_HEIGHT if downloads are too slow or large.
MAX_SOURCE_HEIGHT=1440
OUTPUT_HEIGHT=1080
VIDEO_CRF=18
VIDEO_PRESET=medium
AUDIO_BITRATE=192k

# Total upscale budget. Bounds how far smart reframe may push in, since a
# 9:16 crop already upscales and zoom multiplies it. At 2.0: a 720p source
# gets no zoom at all, 1080p gets 1.12x, 1440p gets 1.5x.
MAX_UPSCALE_FACTOR=2.0


# ── Length and uploads ───────────────────────────────────────────────
# 4 hours. Transcription and highlight detection both window their input,
# so length is no longer a hard ceiling — only patience. A three-hour
# recording is several minutes of real processing.
MAX_VIDEO_DURATION_SECONDS=14400
MAX_UPLOAD_BYTES=524288000
STORAGE_DIR=./storage


# ── Transcription windows ────────────────────────────────────────────
# Groq caps audio uploads at 25MB (~52 min at 64kbps mono). Audio is cut
# into windows; each is extracted slightly early so Whisper has context
# across the seam, but every word is assigned to exactly one window.
# A 10-minute window is ~4.8MB — a wide margin.
TRANSCRIBE_CHUNK_SECONDS=600
TRANSCRIBE_OVERLAP_SECONDS=4


# ── Highlight detection windows ──────────────────────────────────────
# A three-hour podcast is ~27,000 words. Asked to find five moments in all
# of it at once, a model either refuses the context or skims it. Windows
# keep each request to a size the model actually reads; a later pass ranks
# all candidates globally. ~2,500 words is about 17 minutes of speech.
HIGHLIGHT_WINDOW_WORDS=2500
HIGHLIGHT_OVERLAP_WORDS=200


# ── Retention and disk ───────────────────────────────────────────────
# Temporary audio/subtitle files are removed immediately after each stage.
FAILED_JOB_TTL_HOURS=1
THUMBNAIL_TTL_HOURS=24
SOURCE_VIDEO_TTL_HOURS=24
FINAL_CLIP_TTL_DAYS=7
CLEANUP_INTERVAL_MINUTES=30

# Report what cleanup would remove without removing it. Useful for a day
# or two after changing any retention setting.
CLEANUP_DRY_RUN=false

# TTL alone cannot hold a ceiling: a burst of long videos fills the disk
# while every one of them is still hours from expiring. Over this budget,
# least-recently-used jobs are evicted.
MAX_STORAGE_GB=20

# Protects a job that is mid-render — and has no database row yet — from
# being swept as an orphan.
ORPHAN_GRACE_HOURS=2


# ── Downloads ────────────────────────────────────────────────────────
# THE single biggest lever on output quality. Platforms gate their
# high-resolution formats behind a JavaScript signature challenge; without
# a runtime, yt-dlp silently falls back to the 640x360 muxed stream.
# yt-dlp enables only "deno" by default — listing the rest costs nothing
# when they are absent. A startup check warns if none are installed.
YTDLP_JS_RUNTIMES=deno,node,quickjs,bun

# Ranged request size. A single long GET gets a 403 partway through.
YTDLP_HTTP_CHUNK_SIZE=10485760


# ── Platform sign-in cookies ─────────────────────────────────────────
# Fixes "Please sign in to confirm you're not a bot".
#
# Use a THROWAWAY account, not your main one. These cookies make automated
# downloads look like you, and that can get an account flagged.
#
# Export with a cookies.txt browser extension, save it in this folder:
YTDLP_COOKIES_FILE=./cookies.txt

# Per-platform cookies override the shared file above. Twitch subscriber
# VODs, private Vimeo, Instagram and Facebook each need their own session.
# YTDLP_COOKIES_FILE_TWITCH=./cookies-twitch.txt
# YTDLP_COOKIES_FILE_INSTAGRAM=./cookies-instagram.txt

# Fallback (less reliable on Mac/Windows, can fail silently): pull cookies
# straight from a logged-in browser. Options: chrome, safari, firefox, edge
# YTDLP_COOKIES_BROWSER=chrome
