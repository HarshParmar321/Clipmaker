# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Where files are stored on disk (local dev). Swap for Supabase storage/S3 later.
STORAGE_DIR=./storage

# Fixes YouTube's "Please sign in" bot-check error.
# Preferred: export cookies.txt (e.g. via "Get cookies.txt LOCALLY" Chrome
# extension), save it in this folder, and point to it here:
YTDLP_COOKIES_FILE=./cookies.txt

# Fallback (less reliable on Mac/Windows, can fail silently): pull cookies
# directly from a logged-in browser instead. Options: chrome, safari, firefox, edge
# YTDLP_COOKIES_BROWSER=chrome
