# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# AI models used to rank highlights. The 120B model gives the strongest results;
# the backend automatically tries the faster 20B model if the primary is unavailable.
GROQ_HIGHLIGHT_MODEL=openai/gpt-oss-120b
GROQ_HIGHLIGHT_FALLBACK_MODEL=openai/gpt-oss-20b

# Supabase stores job/clip/artifact metadata. Find these in Settings > API Keys.
# Keep the secret key on the backend only; never put it in frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_backend_key_here

# Older Supabase projects can use the legacy service_role key instead:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here

# Authentication is optional during local Phase 1 development. When enabled,
# API calls must send a valid Supabase access token as a Bearer token.
AUTH_REQUIRED=false

# Local media storage and upload limits.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=900

# Cleanup policy. Temporary audio/subtitle files are also removed immediately.
FAILED_JOB_TTL_HOURS=1
THUMBNAIL_TTL_HOURS=24
SOURCE_VIDEO_TTL_HOURS=24
FINAL_CLIP_TTL_DAYS=7
CLEANUP_INTERVAL_MINUTES=30
CLEANUP_DRY_RUN=false

# Fixes YouTube's "Please sign in" bot-check error.
# Preferred: export cookies.txt (e.g. via "Get cookies.txt LOCALLY" Chrome
# extension), save it in this folder, and point to it here:
YTDLP_COOKIES_FILE=./cookies.txt

# Fallback (less reliable on Mac/Windows, can fail silently): pull cookies
# directly from a logged-in browser instead. Options: chrome, safari, firefox, edge
# YTDLP_COOKIES_BROWSER=chrome
